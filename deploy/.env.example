GHCR_NAMESPACE=prodivix
IMAGE_TAG=latest

POSTGRES_PORT=127.0.0.1:5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=prodivix

BACKEND_PORT=8080
# Leave empty to use localhost and 127.0.0.1 at WEB_PORT; set public origins explicitly.
BACKEND_ALLOWED_ORIGINS=
BACKEND_TOKEN_TTL=24h
BACKEND_VERIFICATION_RESUME_KEY=replace-with-a-random-base64-key
# Configure all required reset fields together. Production requires an HTTPS URL.
BACKEND_PASSWORD_RESET_URL=
BACKEND_PASSWORD_RESET_TTL=30m
BACKEND_SMTP_HOST=
BACKEND_SMTP_PORT=587
BACKEND_SMTP_FROM=
BACKEND_SMTP_USERNAME=
BACKEND_SMTP_PASSWORD=
BACKEND_SMTP_TLS_MODE=starttls
BACKEND_DB_MAX_OPEN_CONNS=10
BACKEND_DB_MAX_IDLE_CONNS=5
BACKEND_DB_MAX_LIFETIME=30m
# Startup migration budget per migration; raise for large PIR corpora.
BACKEND_DB_MIGRATION_TIMEOUT=2m

WEB_PORT=4173
SANDBOX_PORT=4174
TZ=UTC
