{
  "name": "@prodivix/cli",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": "./bin/prodivix.js",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "pnpm run typecheck && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js",
    "start": "node dist/cli.js",
    "lint": "eslint .",
    "test": "pnpm run typecheck && tsx --test src/verification.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prodivix/verification": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  }
}
