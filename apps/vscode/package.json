{
  "name": "@prodivix/vscode",
  "displayName": "prodivix",
  "description": "PIR 节点图支持",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pir",
        "aliases": [
          "PIR",
          "pir"
        ],
        "extensions": [
          ".pir.json"
        ],
        "configuration": "./src/language/pir.language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "prodivix.previewPIR",
        "title": "PIR: Preview PIR"
      }
    ],
    "debuggers": [
      {
        "type": "prodivix",
        "label": "Prodivix NodeGraph",
        "program": "./dist/debugAdapter.js",
        "languages": [
          "json"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to a canonical NodeGraph wire .nodegraph.json document."
              },
              "documentRevision": {
                "type": "integer",
                "minimum": 1,
                "default": 1,
                "description": "Read-only document revision, pinned with the compiled Program digest."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "prodivix",
            "request": "launch",
            "name": "Debug NodeGraph",
            "program": "${file}",
            "documentRevision": 1,
            "stopOnEntry": true
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "build": "pnpm run package",
    "dev": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "test:watch": "pnpm run compile && vitest",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm run compile && vitest --run"
  },
  "dependencies": {
    "@prodivix/authoring": "workspace:*",
    "@prodivix/pir": "workspace:*",
    "@prodivix/shared": "workspace:*",
    "@prodivix/vscode-debugger": "workspace:*",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "~26.1.0",
    "@types/vscode": "^1.125.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "vitest": "4.1.9"
  }
}
