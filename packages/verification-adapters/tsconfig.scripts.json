{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@prodivix/runtime-core": ["../runtime-core/src"],
      "@prodivix/runtime-vitest": ["../runtime-vitest/src"],
      "@prodivix/shared": ["../shared/src"],
      "@prodivix/shared/*": ["../shared/src/*"],
      "@prodivix/verification": ["../verification/src"]
    }
  },
  "include": ["scripts/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../runtime-core"
    },
    {
      "path": "../runtime-vitest"
    },
    {
      "path": "../shared"
    },
    {
      "path": "../verification"
    }
  ]
}
