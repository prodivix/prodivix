{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "paths": {
      "@prodivix/behavior": ["../behavior/src"],
      "@prodivix/runtime-core": ["../runtime-core/src"],
      "@prodivix/shared": ["../shared/src"],
      "@prodivix/shared/*": ["../shared/src/*"],
      "@prodivix/verification": ["../verification/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"],
  "references": [
    {
      "path": "../behavior"
    },
    {
      "path": "../runtime-core"
    },
    {
      "path": "../shared"
    },
    {
      "path": "../verification"
    }
  ]
}
