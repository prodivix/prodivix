{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "#host/*": ["./src/*"],
      "@prodivix/plugin-contracts": ["../plugin-contracts/dist/index.d.ts"],
      "@prodivix/shared": ["../shared/dist/index.d.ts"],
      "@prodivix/shared/*": ["../shared/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../plugin-contracts"
    },
    {
      "path": "../shared"
    }
  ]
}
