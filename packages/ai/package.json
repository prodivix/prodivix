{
  "name": "@prodivix/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/wire/agentPolicyWire.d.ts",
      "import": "./dist/wire/agentPolicyWire.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "lint": "eslint .",
    "test": "pnpm run typecheck && vitest --config vitest.config.ts --run",
    "typecheck": "tsc -b tsconfig.test.json --pretty false"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@prodivix/diagnostics": "workspace:*",
    "@prodivix/shared": "workspace:*",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
