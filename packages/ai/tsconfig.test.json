{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest/globals"],
    "paths": {
      "@prodivix/assets": ["../assets/dist/index.d.ts"],
      "@prodivix/diagnostics": ["../diagnostics/dist/index.d.ts"],
      "@prodivix/shared": ["../shared/dist/index.d.ts"],
      "@prodivix/shared/*": ["../shared/dist/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../assets" },
    { "path": "../diagnostics" },
    { "path": "../shared" }
  ]
}
